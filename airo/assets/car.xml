<mujoco model="elegoo-v4">
  <!-- Elegoo Smart Robot Car V4.0. Frame: x forward, y left, z up from the ground under the marker centre. -->
  <asset>
    <mesh name="deck" builtin="supersphere" params="24 .12 .05" scale=".1155 .056 .0015"/>
    <mesh name="waist" builtin="supersphere" params="24 .2 .05" scale=".028 .075 .0015"/>
    <mesh name="battery" builtin="supersphere" params="16 .15 .15" scale=".037 .022 .0115"/>
    <mesh name="gearbox" builtin="supersphere" params="12 .12 .12" scale=".024 .0095 .0112"/>
    <material name="acrylic" rgba=".035 .035 .04 1" specular="1" shininess="1"/>
    <material name="tt" rgba="1 .76 .05 1" specular=".35" shininess=".5"/>
    <material name="hub" rgba="1 .8 .1 1" specular=".4" shininess=".6"/>
    <material name="hub_dark" rgba=".78 .55 .03 1" specular=".2" shininess=".3"/>
    <material name="rubber" rgba=".035 .035 .035 1" specular=".08" shininess=".05"/>
    <material name="brass" rgba=".85 .64 .27 1" specular="1" shininess=".85"/>
    <material name="steel" rgba=".72 .73 .76 1" specular="1" shininess=".9"/>
    <material name="pcb" rgba=".02 .33 .62 1" specular=".5" shininess=".6"/>
    <material name="pcb_black" rgba=".04 .05 .05 1" specular=".4" shininess=".5"/>
    <material name="plastic_black" rgba=".06 .06 .065 1" specular=".25" shininess=".3"/>
    <material name="plastic_white" rgba=".93 .92 .88 1" specular=".2" shininess=".3"/>
    <material name="servo" rgba=".12 .32 .78 1" specular=".3" shininess=".4"/>
    <material name="label" rgba=".9 .45 .08 1" specular=".2" shininess=".3"/>
    <material name="led_green" rgba=".2 1 .3 1" emission="2"/>
    <material name="led_rgb" rgba=".3 .6 1 1" emission="1.5"/>
    <material name="card" rgba="1 1 1 1" texture="aruco0" specular=".1" shininess=".1"/>
  </asset>

  <default>
    <default class="car">
      <geom contype="0" conaffinity="0" group="1" density="0"/>
      <default class="collide">
        <geom contype="1" conaffinity="1" group="3" rgba=".9 .2 .2 .3" density="0"/>
      </default>
      <default class="wheel">
        <joint type="hinge" axis="0 1 0" armature="1e-4" frictionloss=".0068" solreffriction=".004 1"/>
        <geom type="box" material="rubber"/>
        <default class="grip">
          <geom type="sphere" size=".0325" contype="1" conaffinity="1" group="3" condim="6"
                friction=".8 .004 .0002" rgba="0 0 0 0"/>
        </default>
        <default class="lug">
          <geom size=".0026 .0058 .001" pos="0 .0062 .0315"/>
        </default>
        <default class="lug2">
          <geom size=".0026 .0058 .001" pos="0 -.0062 .0315" euler="0 7.5 0"/>
        </default>
        <default class="spoke">
          <geom size=".0024 .0137 .0088" pos="0 0 .0088" material="hub"/>
        </default>
        <default class="disc">
          <geom type="cylinder" zaxis="0 1 0" size=".0308 .013"/>
          <default class="hub">
            <geom size=".0215 .0131" material="hub"/>
          </default>
          <default class="recess">
            <geom size=".0178 .0134" material="hub_dark"/>
          </default>
          <default class="cap">
            <geom size=".0045 .0141" material="steel"/>
          </default>
        </default>
      </default>
      <default class="motor">
        <general ctrlrange="-230 230" ctrllimited="true" gainprm="3e-4" biastype="affine" biasprm="0 0 -2.45e-3"/>
      </default>
      <default class="wire">
        <geom type="capsule" size=".0008" material="plastic_black"/>
      </default>
      <default class="standoff">
        <geom type="cylinder" size=".0026 .0125" material="brass"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="car" pos="1 .6 0" childclass="car">
      <freejoint name="car"/>
      <inertial pos="-.01 0 .058" mass=".84" diaginertia=".0018 .0040 .0053"/>
      <geom name="hull" class="collide" type="box" size=".117 .06 .03" pos="0 0 .07"/>
      <site name="hitch" pos="-.118 0 .046" size=".004" rgba=".9 .9 .9 1"/>
      <site name="deck" pos="-.085 0 .075" size=".001" rgba="0 0 0 0"/>

      <!-- lower deck, brass standoffs, upper deck -->
      <body name="chassis">
        <geom type="mesh" mesh="deck" pos="0 0 .0455" material="acrylic"/>
        <geom type="mesh" mesh="waist" pos="0 0 .0455" material="acrylic"/>
        <geom class="standoff" pos=".1 .042 .0595"/>
        <geom class="standoff" pos=".1 -.042 .0595"/>
        <geom class="standoff" pos="-.1 .042 .0595"/>
        <geom class="standoff" pos="-.1 -.042 .0595"/>
        <geom class="standoff" pos="0 .066 .0595"/>
        <geom class="standoff" pos="0 -.066 .0595"/>
        <geom type="mesh" mesh="deck" pos="0 0 .0735" material="acrylic"/>
        <geom type="mesh" mesh="waist" pos="0 0 .0735" material="acrylic"/>
      </body>

      <!-- TT gear motors under the lower deck, gearbox toward the wheel, motor can toward the centre -->
      <body name="motors">
        <geom type="mesh" mesh="gearbox" pos=".054 .0485 .033" material="tt"/>
        <geom type="mesh" mesh="gearbox" pos=".054 -.0485 .033" material="tt"/>
        <geom type="mesh" mesh="gearbox" pos="-.054 .0485 .033" material="tt"/>
        <geom type="mesh" mesh="gearbox" pos="-.054 -.0485 .033" material="tt"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0102 .0105" pos=".02 .0485 .033" material="steel"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0102 .0105" pos=".02 -.0485 .033" material="steel"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0102 .0105" pos="-.02 .0485 .033" material="steel"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0102 .0105" pos="-.02 -.0485 .033" material="steel"/>
      </body>

      <!-- 2x18650 pack between the decks -->
      <body name="battery">
        <geom type="mesh" mesh="battery" pos="-.035 0 .0585" material="plastic_black"/>
        <geom type="box" size=".022 .0221 .006" pos="-.035 0 .0585" material="label"/>
        <geom type="box" size=".004 .006 .003" pos="-.069 .01 .0705" material="plastic_white"/>
      </body>

      <!-- IR line-tracking bar under the nose -->
      <body name="line_tracker">
        <geom type="box" size=".009 .032 .0008" pos=".098 0 .02" material="pcb_black"/>
        <geom type="cylinder" size=".0022 .011" pos=".098 .024 .0318" material="plastic_black"/>
        <geom type="cylinder" size=".0022 .011" pos=".098 -.024 .0318" material="plastic_black"/>
        <geom type="box" size=".0025 .0035 .002" pos=".1 .016 .0175" material="plastic_black"/>
        <geom type="box" size=".0025 .0035 .002" pos=".1 0 .0175" material="plastic_black"/>
        <geom type="box" size=".0025 .0035 .002" pos=".1 -.016 .0175" material="plastic_black"/>
      </body>

      <!-- jumper wires: sensor ribbon, servo lead, battery lead -->
      <body name="wiring">
        <geom class="wire" fromto=".104 -.0045 .104 .07 -.0045 .096" rgba=".85 .1 .08 1"/>
        <geom class="wire" fromto=".104 -.0015 .104 .07 -.0015 .096" rgba=".95 .8 .1 1"/>
        <geom class="wire" fromto=".104 .0015 .104 .07 .0015 .096" rgba=".1 .65 .25 1"/>
        <geom class="wire" fromto=".104 .0045 .104 .07 .0045 .096" rgba=".08 .08 .08 1"/>
        <geom class="wire" fromto=".07 -.0045 .096 .028 -.0045 .0935" rgba=".85 .1 .08 1"/>
        <geom class="wire" fromto=".07 -.0015 .096 .028 -.0015 .0935" rgba=".95 .8 .1 1"/>
        <geom class="wire" fromto=".07 .0015 .096 .028 .0015 .0935" rgba=".1 .65 .25 1"/>
        <geom class="wire" fromto=".07 .0045 .096 .028 .0045 .0935" rgba=".08 .08 .08 1"/>
        <geom class="wire" fromto=".081 .007 .09 .03 .018 .0935" rgba=".45 .25 .1 1"/>
        <geom class="wire" fromto=".081 .0085 .09 .03 .0195 .0935" rgba=".85 .1 .08 1"/>
        <geom class="wire" fromto=".081 .01 .09 .03 .021 .0935" rgba="1 .5 .05 1"/>
        <geom class="wire" fromto="-.05 .021 .066 -.05 .05 .067" rgba=".85 .1 .08 1"/>
        <geom class="wire" fromto="-.05 .05 .067 -.03 .052 .092" rgba=".85 .1 .08 1"/>
        <geom class="wire" fromto="-.054 .021 .066 -.054 .052 .067" rgba=".08 .08 .08 1"/>
        <geom class="wire" fromto="-.054 .052 .067 -.034 .054 .092" rgba=".08 .08 .08 1"/>
      </body>

      <!-- UNO and the SmartCar shield on the upper deck -->
      <body name="board">
        <geom type="cylinder" size=".0022 .003" pos=".025 .022 .078" material="brass"/>
        <geom type="cylinder" size=".0022 .003" pos="-.04 -.022 .078" material="brass"/>
        <geom type="box" size=".0343 .0267 .0008" pos="-.008 0 .0818" material="pcb"/>
        <geom type="box" size=".008 .006 .0055" pos="-.039 .012 .088" material="steel"/>
        <geom type="box" size=".007 .0045 .0055" pos="-.039 -.016 .088" material="plastic_black"/>
        <geom type="box" size=".0343 .0267 .0008" pos="-.008 0 .0915" material="pcb"/>
        <geom type="box" size=".025 .0013 .0045" pos="-.006 .0245 .0868" material="plastic_black"/>
        <geom type="box" size=".025 .0013 .0045" pos="-.006 -.0245 .0868" material="plastic_black"/>
        <geom type="box" size=".0035 .022 .0028" pos=".022 0 .0951" material="plastic_white"/>
        <geom type="box" size=".012 .0035 .0028" pos="-.012 .021 .0951" material="plastic_white"/>
        <geom type="box" size=".012 .0035 .0028" pos="-.012 -.021 .0951" material="plastic_white"/>
        <geom type="box" size=".0012 .0012 .0006" pos="-.036 -.004 .0928" material="led_green"/>
        <geom type="box" size=".0018 .0018 .0008" pos=".012 .008 .0929" material="led_rgb"/>
      </body>

      <!-- marker 0, 95 mm, on a white card at 0.1 m, top edge forward -->
      <body name="marker_card">
        <geom type="cylinder" size=".002 .0018" pos=".045 .045 .0972" material="plastic_white"/>
        <geom type="cylinder" size=".002 .0018" pos="-.045 -.045 .0972" material="plastic_white"/>
        <geom type="box" size=".064 .064 .0005" pos="0 0 .0994" material="plastic_white"/>
        <geom name="marker" type="box" size=".0633 .0633 .00002" pos="0 0 .09998" euler="0 0 -90" material="card"/>
      </body>

      <!-- SG90 servo and the HC-SR04 eyes -->
      <body name="sensor">
        <geom type="box" size=".0115 .006 .011" pos=".09 0 .0855" material="servo"/>
        <geom type="box" size=".016 .006 .0012" pos=".09 0 .0925" material="servo"/>
        <geom type="cylinder" size=".0035 .0025" pos=".095 0 .099" material="plastic_white"/>
        <geom type="box" size=".006 .022 .0012" pos=".1 0 .1015" material="plastic_black"/>
        <geom type="box" size=".0008 .0225 .0105" pos=".1065 0 .109" material="pcb"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0081 .006" pos=".1133 .0132 .109" material="steel"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0081 .006" pos=".1133 -.0132 .109" material="steel"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0066 .0002" pos=".1194 .0132 .109" material="pcb_black"/>
        <geom type="cylinder" zaxis="1 0 0" size=".0066 .0002" pos=".1194 -.0132 .109" material="pcb_black"/>
        <geom type="box" size=".0015 .004 .0018" pos=".109 0 .1155" material="steel"/>
      </body>

      <body name="fl" pos=".065 .0725 .0325" childclass="wheel">
        <joint name="fl"/><site name="fl" size=".034" rgba="0 0 0 0"/><geom class="grip"/><geom class="disc"/><geom class="hub"/><geom class="recess"/><geom class="cap"/>
        <inertial pos="0 0 0" mass=".025" diaginertia="8e-6 1.3e-5 8e-6"/>
        <replicate count="5" euler="0 72 0"><geom class="spoke"/></replicate>
        <replicate count="24" euler="0 15 0"><geom class="lug"/><geom class="lug2"/></replicate>
      </body>
      <body name="rl" pos="-.065 .0725 .0325" childclass="wheel">
        <joint name="rl"/><site name="rl" size=".034" rgba="0 0 0 0"/><geom class="grip"/><geom class="disc"/><geom class="hub"/><geom class="recess"/><geom class="cap"/>
        <inertial pos="0 0 0" mass=".025" diaginertia="8e-6 1.3e-5 8e-6"/>
        <replicate count="5" euler="0 72 0"><geom class="spoke"/></replicate>
        <replicate count="24" euler="0 15 0"><geom class="lug"/><geom class="lug2"/></replicate>
      </body>
      <body name="fr" pos=".065 -.0725 .0325" childclass="wheel">
        <joint name="fr"/><site name="fr" size=".034" rgba="0 0 0 0"/><geom class="grip"/><geom class="disc"/><geom class="hub"/><geom class="recess"/><geom class="cap"/>
        <inertial pos="0 0 0" mass=".025" diaginertia="8e-6 1.3e-5 8e-6"/>
        <replicate count="5" euler="0 72 0"><geom class="spoke"/></replicate>
        <replicate count="24" euler="0 15 0"><geom class="lug"/><geom class="lug2"/></replicate>
      </body>
      <body name="rr" pos="-.065 -.0725 .0325" childclass="wheel">
        <joint name="rr"/><site name="rr" size=".034" rgba="0 0 0 0"/><geom class="grip"/><geom class="disc"/><geom class="hub"/><geom class="recess"/><geom class="cap"/>
        <inertial pos="0 0 0" mass=".025" diaginertia="8e-6 1.3e-5 8e-6"/>
        <replicate count="5" euler="0 72 0"><geom class="spoke"/></replicate>
        <replicate count="24" euler="0 15 0"><geom class="lug"/><geom class="lug2"/></replicate>
      </body>
    </body>
  </worldbody>

  <sensor>
    <touch site="fl"/>
    <touch site="rl"/>
    <touch site="fr"/>
    <touch site="rr"/>
  </sensor>

  <actuator>
    <general name="fl" joint="fl" class="motor"/>
    <general name="rl" joint="rl" class="motor"/>
    <general name="fr" joint="fr" class="motor"/>
    <general name="rr" joint="rr" class="motor"/>
  </actuator>
</mujoco>
